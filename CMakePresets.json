{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "environment": {
        "VCLibPackagePath": "${sourceDir}/build/no-vcpkg/vcpkg.user"
      },
      "toolset": "v143"
    },
    {
      "name": "ci-windows",
      "displayName": "Windows CI (Ninja, MSVC developer shell)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ci-windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "DINGOSDK_VERSION": "20261114",
        "DINGOSDK_MOD_ID": "AnimatorStudio",
        "DINGOSDK_MOD_VERSION": "2.1.4+reskate.20261114",
        "DINGOSDK_MOD_NAME": "Animator Studio",
        "DINGOSDK_BUILD_ANIMATION_STUDIO_TESTS": "ON",
        "DINGOSDK_BUILD_PLUGIN_TESTS": "ON",
        "DINGOSDK_BUILD_LAUNCHER_TESTS": "ON",
        "DINGOSDK_RELEASE_REPO": "FourthStudio/ReSkate-Animator-Studio",
        "DINGOSDK_CRASH_REPORT_URL": "",
        "DINGOSDK_LAUNCHER_AUTO_UPDATE": "OFF",
        "DINGOSDK_EMBEDDED_DEBUG_INFO": "ON"
      }
    },
    {
      "name": "vs2022-x64-dev",
      "displayName": "Visual Studio 2022 x64, with the research tools (development only)",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64-dev",
      "cacheVariables": {
        "DINGOSDK_DEV_TOOLS": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (dedicated server only)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "dev-release",
      "configurePreset": "vs2022-x64-dev",
      "configuration": "Release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-x64"
    }
  ]
}
